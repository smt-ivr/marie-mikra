// Cloudflare deployment config: static site in ./public
// (new version at "/", the original version unchanged at "/legacy/").
// src/worker.js also serves it under smti.uk/marie-mikra (Worker route).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "marie-mikra",
  "main": "src/worker.js",
  "compatibility_date": "2025-10-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  }
}
